# Local development only. Copy to .env and replace passwords before starting.
API_PORT=4000
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=employee_it
DB_USER=employee_it_app
DB_PASSWORD=replace_with_a_local_password
MYSQL_ROOT_PASSWORD=replace_with_another_local_password

# Keycloak local development
KEYCLOAK_ISSUER=http://127.0.0.1:8080/realms/employee-it
KEYCLOAK_AUDIENCE=employee-it-api
KEYCLOAK_ADMIN_PASSWORD=replace_with_a_keycloak_admin_password
KEYCLOAK_DEMO_PASSWORD=replace_with_a_demo_password

KEYCLOAK_SERVICE_CLIENT=employee-it-provisioner
KEYCLOAK_SERVICE_SECRET=replace_with_a_service_client_secret
