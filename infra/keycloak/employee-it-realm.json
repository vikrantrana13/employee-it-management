{
  "realm": "employee-it",
  "enabled": true,
  "displayName": "Employee IT Workspace",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "bruteForceProtected": true,
  "sslRequired": "external",
  "accessTokenLifespan": 300,
  "roles": {
    "realm": [
      {
        "name": "employee"
      },
      {
        "name": "it-support"
      },
      {
        "name": "admin"
      }
    ]
  },
  "clients": [
    {
      "clientId": "employee-it-api",
      "enabled": true,
      "protocol": "openid-connect",
      "bearerOnly": true
    },
    {
      "clientId": "employee-it-portal",
      "name": "Employee IT Portal",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "redirectUris": [
        "http://127.0.0.1:5173/"
      ],
      "webOrigins": [
        "http://127.0.0.1:5173"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://127.0.0.1:5173/"
      },
      "defaultClientScopes": [
        "web-origins",
        "roles",
        "profile",
        "email",
        "basic"
      ],
      "fullScopeAllowed": true,
      "protocolMappers": [
        {
          "name": "employee-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "employee-it-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "employee-it-knowledge",
      "name": "Employee IT Knowledge Base",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "redirectUris": [
        "http://127.0.0.1:5174/",
        "http://127.0.0.1:5174/team-wiki/"
      ],
      "webOrigins": [
        "http://127.0.0.1:5174"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://127.0.0.1:5174/##http://127.0.0.1:5174/team-wiki/"
      },
      "defaultClientScopes": [
        "web-origins",
        "roles",
        "profile",
        "email",
        "basic"
      ],
      "fullScopeAllowed": true,
      "protocolMappers": [
        {
          "name": "employee-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "employee-it-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "employee.demo",
      "enabled": true,
      "email": "employee.demo@example.test",
      "emailVerified": true,
      "firstName": "Employee",
      "lastName": "Demo",
      "credentials": [
        {
          "type": "password",
          "value": "${KEYCLOAK_DEMO_PASSWORD}",
          "temporary": false
        }
      ],
      "realmRoles": [
        "employee"
      ]
    },
    {
      "username": "support.demo",
      "enabled": true,
      "email": "support.demo@example.test",
      "emailVerified": true,
      "firstName": "Support",
      "lastName": "Demo",
      "credentials": [
        {
          "type": "password",
          "value": "${KEYCLOAK_DEMO_PASSWORD}",
          "temporary": false
        }
      ],
      "realmRoles": [
        "it-support"
      ]
    },
    {
      "username": "admin.demo",
      "enabled": true,
      "email": "admin.demo@example.test",
      "emailVerified": true,
      "firstName": "Admin",
      "lastName": "Demo",
      "credentials": [
        {
          "type": "password",
          "value": "${KEYCLOAK_DEMO_PASSWORD}",
          "temporary": false
        }
      ],
      "realmRoles": [
        "admin"
      ]
    },
    {
      "username": "mfa.demo",
      "enabled": true,
      "email": "mfa.demo@example.test",
      "emailVerified": true,
      "firstName": "MFA",
      "lastName": "Demo",
      "requiredActions": [
        "CONFIGURE_TOTP"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "${KEYCLOAK_DEMO_PASSWORD}",
          "temporary": false
        }
      ],
      "realmRoles": [
        "employee"
      ]
    }
  ]
}
